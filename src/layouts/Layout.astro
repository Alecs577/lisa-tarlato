---
import "../styles/global.css";
import { path, site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/jpeg" href={path("logo.jpg")} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EDE6DC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="bg-dawn text-ink antialiased">
    <div class="grain" aria-hidden="true"></div>
    <div class="cursor-dot hidden lg:block" aria-hidden="true"></div>
    <div class="cursor-ring hidden lg:block" aria-hidden="true"></div>
    <a
      href="#contenuto"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-mist focus:px-4 focus:py-2"
    >
      Vai al contenuto
    </a>
    <slot />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>
