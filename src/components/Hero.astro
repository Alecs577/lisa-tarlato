---
import { path, site, whatsappHref } from "../data/site";
---

<section id="inizio" data-hero class="relative min-h-svh overflow-hidden text-mist">
  <div data-hero-media class="absolute inset-0">
    <img
      src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?auto=format&fit=crop&w=2200&q=80"
      alt="Lezione di Hatha yoga"
      class="h-full w-full object-cover object-[center_42%] sm:object-center"
    />
    <div class="absolute inset-0 bg-linear-to-t from-ink/80 via-ink/30 to-ink/25 sm:from-ink/75 sm:via-ink/30 sm:to-ink/40"></div>
  </div>

  <img
    data-hero-sun
    src={path("logo.jpg")}
    alt=""
    class="pointer-events-none absolute left-1/2 top-[14%] hidden h-24 w-24 -translate-x-1/2 rounded-full object-cover shadow-[0_12px_40px_-18px_rgba(22,20,18,0.55)] sm:block md:h-28 md:w-28"
  />

  <div class="relative mx-auto flex min-h-svh max-w-6xl flex-col px-4 pb-16 pt-24 sm:justify-end sm:px-6 sm:pb-16 md:justify-center md:px-8 md:pb-24">
    <div class="flex flex-1 flex-col items-center justify-center gap-4 sm:hidden">
      <img
        data-hero-sun
        src={path("logo.jpg")}
        alt=""
        class="h-[4.75rem] w-[4.75rem] rounded-full object-cover shadow-[0_16px_40px_-18px_rgba(22,20,18,0.6)]"
      />
      <ul data-hero-copy data-anim class="flex flex-wrap items-center justify-center gap-2">
        <li class="rounded-full border border-mist/30 bg-ink/40 px-3 py-1.5 text-[10px] uppercase tracking-[0.16em] text-mist backdrop-blur-sm">
          Hatha yoga
        </li>
        <li class="rounded-full border border-mist/30 bg-ink/40 px-3 py-1.5 text-[10px] uppercase tracking-[0.16em] text-mist backdrop-blur-sm">
          Trattamenti
        </li>
        <li class="rounded-full border border-mist/30 bg-ink/40 px-3 py-1.5 text-[10px] uppercase tracking-[0.16em] text-mist backdrop-blur-sm">
          Cadro
        </li>
      </ul>
    </div>

    <div class="flex flex-col">
      <p
        data-hero-copy
        data-anim
        class="inline-flex max-w-full self-start rounded-full bg-ink/45 px-3.5 py-1.5 text-[11px] uppercase tracking-[0.22em] text-mist shadow-[0_8px_24px_-12px_rgba(22,20,18,0.55)] backdrop-blur-sm"
      >
        {site.teacher} · {site.tagline}
      </p>
      <h1
        data-hero-title
        data-anim
        class="mt-4 max-w-[12ch] font-display text-[clamp(2.15rem,10vw,4.5rem)] leading-[0.95] italic sm:mt-5 sm:max-w-none sm:whitespace-nowrap"
      >
        Uno spazio dedicato a te
      </h1>
      <p data-hero-copy data-anim class="mt-4 max-w-md text-[0.95rem] font-light leading-6 text-mist/90 sm:mt-6 sm:text-base sm:leading-7">
        Hatha yoga, massaggi e trattamenti a Cadro. Lezioni individuali o in piccoli gruppi, guidate con attenzione al tuo ritmo.
      </p>
      <div data-hero-copy data-anim class="mt-6 flex w-full flex-col gap-3 sm:mt-9 sm:w-auto sm:flex-row sm:flex-wrap">
        <a href={whatsappHref()} class="pill w-full bg-terra text-mist sm:w-auto">Contatta Lisa</a>
        <a href={path("/#percorsi")} class="pill w-full border border-mist/50 text-mist sm:w-auto">Scopri le proposte</a>
      </div>
    </div>
  </div>
</section>
