---
import { site, whatsappHref } from "../data/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const links = [
  {
    href: `mailto:${site.email}`,
    label: `Email ${site.email}`,
    icon: "mail",
  },
  {
    href: whatsappHref(),
    label: "WhatsApp",
    icon: "whatsapp",
  },
  {
    href: site.instagramUrl,
    label: `Instagram @${site.instagramHandle}`,
    icon: "instagram",
  },
] as const;
---

<nav class:list={["flex items-center justify-center gap-5", className]} aria-label="Contatti">
  {
    links.map((item) => (
      <a
        href={item.href}
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-mist/20 text-mist transition hover:border-gold hover:text-gold"
        aria-label={item.label}
      >
        {item.icon === "mail" && (
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"></rect>
            <path d="M4 7l8 6 8-6"></path>
          </svg>
        )}
        {item.icon === "whatsapp" && (
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01zm-7.01 15.24h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.14.82.84-3.06-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.55-3.7 8.24-8.22 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.76-1.84-.2-.48-.4-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z"></path>
          </svg>
        )}
        {item.icon === "instagram" && (
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.4" cy="6.6" r="0.7" fill="currentColor" stroke="none"></circle>
          </svg>
        )}
      </a>
    ))
  }
</nav>
