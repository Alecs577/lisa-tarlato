---
import { pillars } from "../data/site";
---

<section id="pratica" data-practice class="relative scroll-mt-24 overflow-hidden">
  <div
    data-practice-track
    class="flex flex-col lg:h-svh lg:w-max lg:flex-row lg:flex-nowrap"
  >
    {
      pillars.map((item) => (
        <article
          data-practice-card
          data-anim
          class="flex w-full flex-col justify-center px-5 py-14 sm:px-8 md:px-10 md:py-16 lg:h-svh lg:w-screen lg:flex-row lg:items-center lg:gap-16 lg:px-16 xl:px-20"
        >
          <p class="font-display text-6xl italic text-gold/70 sm:text-7xl md:text-8xl lg:text-9xl">{item.num}</p>
          <div class="mt-4 max-w-md md:mt-0">
            <h2 class="font-display text-3xl italic sm:text-4xl md:text-5xl lg:text-6xl">{item.name}</h2>
            <p class="mt-4 font-light leading-7 text-stone sm:mt-5 sm:leading-8">{item.text}</p>
          </div>
          <div class="mt-6 overflow-hidden md:mt-8 md:max-w-lg lg:mt-0 lg:ml-auto lg:w-[38%]">
            <img src={item.src} alt={item.alt} class="aspect-4/5 w-full object-cover" />
          </div>
        </article>
      ))
    }
  </div>
</section>
