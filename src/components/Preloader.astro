---
import { path } from "../data/site";
---

<div
  data-preloader
  class="fixed inset-0 z-[80] flex items-center justify-center overflow-hidden"
>
  <div data-preloader-panel class="absolute inset-x-0 top-0 h-1/2 bg-dawn"></div>
  <div data-preloader-panel class="absolute inset-x-0 bottom-0 h-1/2 bg-dawn"></div>
  <img
    data-preloader-mark
    src={path("logo.jpg")}
    alt=""
    class="relative z-10 h-24 w-24 rounded-full object-cover sm:h-28 sm:w-28"
  />
</div>
