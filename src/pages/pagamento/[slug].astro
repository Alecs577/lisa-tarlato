---
import Page from "../../layouts/Page.astro";
import { packageNarratives, packages, path, site, whatsappHref } from "../../data/site";
import { stripePaymentLinks } from "../../data/stripe-links";

export function getStaticPaths() {
  return packages.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const story = packageNarratives[item.slug];
const related = packages
  .filter((other) => other.slug !== item.slug && other.group === item.group)
  .slice(0, 3);
const savings = Math.max(
  0,
  Math.round(((Number(item.priceOld) - Number(item.price)) / Number(item.priceOld)) * 100),
);
const category = item.group === "yoga" ? "Hatha yoga" : "Massaggi e trattamenti";
const bookingMessage =
  "Ciao Lisa, vorrei informazioni e disponibilità per “" + item.name + "” (" + item.duration + ").";
const paymentLink = stripePaymentLinks[item.slug];
---

<Page
  title={`${item.name} — ${site.name}`}
  description={`${story.intro} ${item.duration}, ${item.place}. Tariffa CHF ${item.price}.`}
>
  <main id="contenuto" class="pb-20 pt-24 sm:pt-28">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <a
        href={path("/#percorsi")}
        data-back
        class="inline-flex items-center gap-2 py-3 text-sm font-light text-stone transition hover:text-ink"
      >
        <span aria-hidden="true">←</span> Torna al listino
      </a>
    </div>

    <section class="mx-auto mt-5 grid max-w-6xl gap-8 px-5 sm:mt-8 sm:px-8 lg:grid-cols-12 lg:gap-12">
      <figure class="relative overflow-hidden rounded-[1.5rem] bg-sand lg:col-span-7 lg:rounded-[2rem]">
        <img
          src={item.detailImage}
          alt={item.detailImageAlt}
          fetchpriority="high"
          class="aspect-[4/3] h-full w-full object-cover sm:aspect-[5/4] lg:aspect-[4/4.3]"
        />
        <figcaption class="absolute bottom-4 left-4 rounded-full bg-ink/55 px-3 py-1.5 text-[10px] uppercase tracking-[0.16em] text-mist backdrop-blur-sm">
          {category} · {site.city}
        </figcaption>
      </figure>

      <div class="flex flex-col justify-center lg:col-span-5">
        <p class="text-[11px] uppercase tracking-[0.25em] text-olive">{category}</p>
        {item.featured && (
          <p class="mt-4 inline-flex w-fit rounded-full bg-olive/10 px-3 py-1.5 text-[10px] font-medium uppercase tracking-[0.14em] text-olive">
            Tariffa pacchetto
          </p>
        )}
        <h1 class="mt-4 font-display text-4xl italic leading-[1.02] sm:text-5xl lg:text-6xl">
          {item.name}
        </h1>
        <p class="mt-5 text-base font-light leading-7 text-stone sm:text-lg">{story.intro}</p>

        <div class="mt-7 flex flex-wrap items-end gap-x-4 gap-y-2 border-y border-ink/10 py-5">
          <p class="font-display text-4xl text-ink">CHF {item.price}.-</p>
          <p class="pb-1 text-sm text-stone line-through decoration-stone/70">CHF {item.priceOld}.-</p>
          {savings > 0 && (
            <span class="mb-1 rounded-full bg-olive/10 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wide text-olive">
              Risparmi {savings}%
            </span>
          )}
        </div>

        <dl class="mt-5 grid grid-cols-2 gap-x-5 gap-y-4 text-sm">
          <div>
            <dt class="text-[10px] uppercase tracking-[0.16em] text-stone">Durata</dt>
            <dd class="mt-1 font-medium">{item.duration}</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.16em] text-stone">Dove</dt>
            <dd class="mt-1 font-medium">Cadro</dd>
          </div>
          <div class="col-span-2">
            <dt class="text-[10px] uppercase tracking-[0.16em] text-stone">Indirizzo</dt>
            <dd class="mt-1 font-medium">{item.place}</dd>
          </div>
        </dl>

        {paymentLink ? (
          <a href={paymentLink} class="pill mt-7 w-full bg-olive text-mist sm:w-fit">
            Paga online con Stripe
          </a>
        ) : (
          <a
            href={whatsappHref("Ciao Lisa, vorrei il link Stripe per “" + item.name + "” (" + item.duration + ").")}
            class="pill mt-7 w-full bg-olive text-mist sm:w-fit"
          >
            Chiedi il link di pagamento
          </a>
        )}
        <p class="mt-3 text-xs font-light leading-5 text-stone">
          {paymentLink
            ? "Il pagamento si completa sulla pagina protetta di Stripe. Per concordare giorno e orario, scrivimi su WhatsApp."
            : "Per questa proposta il pagamento online non è ancora disponibile. Scrivimi su WhatsApp: ti aiuto a completare la prenotazione."}
        </p>
        <a href={whatsappHref(bookingMessage)} class="mt-3 inline-flex text-xs text-olive underline decoration-olive/30 underline-offset-4">
          Vuoi un consiglio prima di scegliere? Scrivimi
        </a>
      </div>
    </section>

    <section class="mx-auto mt-16 grid max-w-6xl gap-10 px-5 sm:mt-24 sm:px-8 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-7">
        <p class="text-[11px] uppercase tracking-[0.25em] text-olive">La proposta</p>
        <h2 class="mt-3 font-display text-3xl italic sm:text-4xl">La proposta, nel dettaglio</h2>
        <p class="mt-5 max-w-2xl font-light leading-8 text-stone">{item.text}</p>
        <p class="mt-4 max-w-2xl font-light leading-8 text-stone">{story.idealFor}</p>
      </div>

      <aside class="rounded-[1.5rem] bg-mist/80 p-6 sm:p-8 md:col-span-5">
        <p class="text-[11px] uppercase tracking-[0.25em] text-olive">Cosa comprende</p>
        <ul class="mt-5 space-y-4">
          {item.includes.map((detail) => (
            <li class="flex gap-3 text-sm font-light leading-6 text-stone">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-olive" aria-hidden="true"></span>
              <span>{detail}</span>
            </li>
          ))}
        </ul>
        <a href={site.mapsUrl} class="mt-7 inline-flex text-sm text-olive underline decoration-olive/30 underline-offset-4">
          Indicazioni per lo studio
        </a>
      </aside>
    </section>

    {related.length > 0 && (
      <section class="mx-auto mt-20 max-w-6xl px-5 sm:mt-28 sm:px-8">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="text-[11px] uppercase tracking-[0.25em] text-olive">Potrebbe interessarti</p>
            <h2 class="mt-3 font-display text-3xl italic sm:text-4xl">Continua a esplorare</h2>
          </div>
          <a href={path("/#percorsi")} class="text-sm text-stone underline decoration-ink/20 underline-offset-4 hover:text-ink">
            Torna al listino
          </a>
        </div>

        <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((other) => (
            <a
              href={path(`/pagamento/${other.slug}`)}
              class="group overflow-hidden rounded-[1.3rem] bg-mist/75 transition hover:-translate-y-1"
            >
              <img
                src={other.detailImage}
                alt={other.detailImageAlt}
                loading="lazy"
                class="aspect-[16/10] w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              />
              <div class="p-5">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-display text-xl italic">{other.short}</h3>
                  <span class="font-display text-xl">CHF {other.price}.-</span>
                </div>
                <p class="mt-2 text-xs font-light text-stone">{other.duration}</p>
                <span class="mt-4 inline-flex text-[10px] font-medium uppercase tracking-[0.16em] text-olive">
                  Scopri i dettagli <span class="ml-2 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>
</Page>
