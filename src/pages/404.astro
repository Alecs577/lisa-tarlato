---
import Page from "../layouts/Page.astro";
import SunMark from "../components/SunMark.astro";
import { site } from "../data/site";
---

<Page title={`Pagina non trovata — ${site.name}`}>
  <main id="contenuto" class="flex min-h-svh flex-col items-center justify-center px-6 pb-24 pt-28 text-center">
    <SunMark class="h-12 w-12" />
    <p class="mt-8 font-display text-6xl italic text-terra sm:text-7xl">404</p>
    <h1 class="mt-4 max-w-md font-display text-2xl italic sm:text-3xl">
      Qui non c’è la pagina che cercavi
    </h1>
    <p class="mt-4 max-w-sm font-light leading-7 text-stone">
      Puoi ripartire dal sito o scrivere a Lisa: ti aiuterà a trovare la proposta giusta per te.
    </p>
    <div class="mt-8 flex w-full max-w-sm flex-col gap-3 sm:w-auto sm:flex-row">
      <a href="/" data-back class="pill w-full bg-terra text-mist sm:w-auto">Torna al sito</a>
      <a href="/#contatti" class="pill w-full border border-ink/15 sm:w-auto">Scrivi a Lisa</a>
    </div>
  </main>
</Page>
